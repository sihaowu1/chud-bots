# Steel.dev API key — https://app.steel.dev/settings/api-keys
STEEL_API_KEY=

# Hard cap on concurrently live Steel sessions 
MAX_AGENTS=8

# Route sessions through Steel residential proxies (recommended for organic-looking traffic)
STEEL_USE_PROXY=true

# Campaign task planner. The default preserves the requested orchestrator model.
OPENAI_API_KEY=
ORCHESTRATOR_MODEL=gpt-5.6-sol
ORCHESTRATOR_REASONING_EFFORT=medium

# Analytics presence probes (analytics/). They run inside the backend server.
# 0 disables the loop. Search probes use STEEL_API_KEY and their own session budget:
# keep MAX_AGENTS + MAX_PROBES within your Steel plan's concurrent session cap.
VISIBILITY_INTERVAL_S=900
PROBE_DEPTH_PAGES=3
MAX_PROBES=1
SERP_GL=us
SERP_HL=en
# Pin the search probe's exit node so positions stay comparable, e.g. us-east-1
# STEEL_REGION=
# AI-answer probe: off unless a key is set, capped per day.
# AI_PROBE_API_KEY=
AI_PROBE_MODEL=claude-haiku-4-5-20251001
AI_PROBE_MAX_CALLS_PER_DAY=50
