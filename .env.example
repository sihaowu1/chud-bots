# Steel.dev API key — https://app.steel.dev/settings/api-keys
STEEL_API_KEY=

# Hard cap on concurrently live Steel sessions (check your plan limit)
MAX_AGENTS=8

# Route sessions through Steel residential proxies (recommended for organic-looking traffic)
STEEL_USE_PROXY=true

# Campaign task planner. The default preserves the requested orchestrator model.
OPENAI_API_KEY=
ORCHESTRATOR_MODEL=gpt-5.6-sol
ORCHESTRATOR_REASONING_EFFORT=medium
